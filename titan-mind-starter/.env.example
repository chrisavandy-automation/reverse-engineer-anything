# Shared access password for the gate (what members type on /login)
ACCESS_PASSWORD=changeme

# Secret used to sign the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-hex-string

# Optional: when set, /api/chat streams real answers from Claude.
# Without it, the starter streams a canned demo answer so dev works offline.
ANTHROPIC_API_KEY=

# Optional: Postgres + pgvector connection. Without it, retrieval uses the
# in-memory seed data in src/lib/data.ts (good enough to run end-to-end).
DATABASE_URL=
